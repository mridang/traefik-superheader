{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.7/.schema/devbox.schema.json",
  "packages": {
    "dprint": "latest",
    "go": "1.27",
    "gotestsum": "latest",
    "tinygo": "0.42.0",
    "github:NixOS/nixpkgs/nixpkgs-unstable#golangci-lint": ""
  },
  "env": {
    "GOMODCACHE": "$DEVBOX_PROJECT_ROOT/.go",
    "GOTOOLCHAIN": "local",
    "GOROOT": null
  },
  "shell": {
    "scripts": {
      "test": "make test",
      "build": "make build",
      "lint": "make lint",
      "format": "make format",
      "generate": "make generate"
    }
  }
}
